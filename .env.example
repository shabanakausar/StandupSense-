# ─── Notion ───────────────────────────────────────────────────────────────────
# Create an Internal Integration at https://notion.so/my-integrations
# Enable: Read content + Read comments
# Share your task database with the integration
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Property names as they appear in YOUR Notion database (case-sensitive)
NOTION_STATUS_PROP=Status
NOTION_DUE_DATE_PROP=Due Date
NOTION_ASSIGNEE_PROP=Assignee

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Classic PAT: needs "repo" scope (private) or "public_repo" scope (public)
# Fine-grained PAT: needs "Contents: Read-only" + "Pull requests: Read-only"
# NOTE: "repo:read" does NOT exist as a classic PAT scope — do not use it
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-org-or-username
GITHUB_REPO=your-repo-name

# ─── IBM watsonx ──────────────────────────────────────────────────────────────
# Get credentials at https://cloud.ibm.com/iam/apikeys
# Verify your model ID: GET /ml/v1/foundation_model_specs?version=2023-05-29
WATSONX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WATSONX_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-2b-instruct

# ─── OpenAI (optional fallback if watsonx is unavailable) ────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Demo mode ────────────────────────────────────────────────────────────────
# Set to "true" to skip all live API calls and load from cache/demo-fixture.json
DEMO_MODE=false
